   "text": "index.ts   routes, notFound,\n           onError -> { error }\nhomes.ts   homes, members, bills list,\n           balances\nbills.ts   create bill, pay share\ninput.ts   JSON + field checks (400/422)\nsplit.ts   floor(total/n), +1c to the\n           first total % n members\nrows.ts    db row -> JSON, homeOr404",
