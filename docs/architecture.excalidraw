   "isDeleted": false,
   "boundElements": [],
   "updated": 1793600000000,
   "link": null,
   "locked": false,
   "text": "D1 runs writes one at a time. The check (paid_at IS NULL)\nand the write are the same statement, so only one request\ngets a row back. The loser falls through to SELECT -> 409.",
   "originalText": "D1 runs writes one at a time. The check (paid_at IS NULL)\nand the write are the same statement, so only one request\ngets a row back. The loser falls through to SELECT -> 409.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
