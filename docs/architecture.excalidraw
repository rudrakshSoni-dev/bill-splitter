   "text": "homes    id, name\nmembers  home_id, name, position\nbills    home_id, title, total_cents\nshares   bill_id, member_id,\n         amount_cents, paid_at, pay_key\n\nFKs on every parent, UNIQUE(home_id,\nposition), UNIQUE(bill_id, member_id),\nCHECK total_cents integer > 0,\nCHECK paid_at and pay_key set together",
   "originalText": "homes    id, name\nmembers  home_id, name, position\nbills    home_id, title, total_cents\nshares   bill_id, member_id,\n         amount_cents, paid_at, pay_key\n\nFKs on every parent, UNIQUE(home_id,\nposition), UNIQUE(bill_id, member_id),\nCHECK total_cents integer > 0,\nCHECK paid_at and pay_key set together",
